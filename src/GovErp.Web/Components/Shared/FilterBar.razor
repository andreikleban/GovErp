@* Filters above a list table: the fields come as child content; Clear is shown if the page can reset the filters. *@
<div class="filter-bar" role="search">
    @ChildContent
    @if (OnClear.HasDelegate)
    {
        <button type="button" class="filter-clear" disabled="@(!Active)" @onclick="OnClear">Clear filters</button>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    /// <summary>Whether any filters are set: without them Clear changes nothing and is disabled.</summary>
    [Parameter] public bool Active { get; set; }
}
