<span class="badge @Tone" title="@Title">@Status</span>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = "";
    [Parameter] public string Title { get; set; } = "Document status";

    /// <summary>Color by the meaning of the status: in progress, awaiting a decision, approved or posted, rejected.</summary>
    private string Tone => Status switch
    {
        "Submitted" => "info",
        "Approved" => "ok",
        "Posted" => "done",
        "Rejected" => "bad",
        _ => "muted",
    };
}
