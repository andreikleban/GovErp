@* An account links to the budget line card (Budget › Budget Lines) for the document's budget year. *@
<a class="account" href="@Href" title="Budget line @Account, FY@(FiscalYear)">@Account</a>

@code {
    [Parameter, EditorRequired] public string Account { get; set; } = "";
    [Parameter, EditorRequired] public int FiscalYear { get; set; }

    private string Href => $"/budget/lines/{Uri.EscapeDataString(Account)}/{FiscalYear}";
}
