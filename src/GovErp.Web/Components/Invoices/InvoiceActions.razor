<p>
    <button type="button" disabled="@(Busy || !CanEdit)" @onclick="OnSave">Save</button>
    <button type="button" disabled="@Busy" @onclick="OnValidate">Validate</button>
    <button type="button" disabled="@(Busy || !CanEdit)" @onclick="OnSubmit">Submit</button>
</p>

@code {
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnValidate { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
}
