@using GovErp.Application.Web.Reference.Contracts
@using GovErp.Web.Formatting
@using Microsoft.AspNetCore.Components.Forms

<EditForm Model="Edit">
    <div>
        <label>Vendor invoice no. <InputText @bind-Value="Edit.Number" disabled="@(!NumberEditable)" /></label>
        <label>Document date <InputDate @bind-Value="Edit.DocumentDate" disabled="@ReadOnly" /></label>
        <label>Due date <InputDate @bind-Value="Edit.DueDate" disabled="@ReadOnly" /></label>
        <label>Vendor
            <InputSelect @bind-Value="Edit.VendorId" disabled="@ReadOnly">
                @foreach (var v in Vendors) { <option value="@v.Id">@v.Name</option> }
            </InputSelect>
        </label>
        <label>Header amount (USD) <InputNumber @bind-Value="Edit.Total" disabled="@ReadOnly" /></label>
        <label>PO
            <InputSelect @bind-Value="Edit.PoRef" disabled="@ReadOnly">
                <option value="">(none)</option>
                @foreach (var po in PurchaseOrders) { <option value="@po.Number">@po.Number</option> }
            </InputSelect>
        </label>
    </div>
    <p class="note">Invoice, service and posting dates use this one document date.</p>
    <p class="note">Line sum @MoneyText.Usd(Edit.LineSum) — difference @MoneyText.Usd(Edit.Difference)</p>
    <DistributionEditor Edit="Edit" Segments="Segments" PurchaseOrders="PurchaseOrders" ReadOnly="ReadOnly" />
</EditForm>

@code {
    [Parameter, EditorRequired] public EditorModel Edit { get; set; } = null!;
    [Parameter] public IReadOnlyList<VendorVm> Vendors { get; set; } = [];
    [Parameter] public IReadOnlyList<PurchaseOrderVm> PurchaseOrders { get; set; } = [];
    [Parameter] public SegmentsVm? Segments { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Номер вводится только при создании: после него это идентичность для проверки дубликатов.</summary>
    [Parameter] public bool NumberEditable { get; set; }
}
