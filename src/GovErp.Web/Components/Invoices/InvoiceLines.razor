@using System.Globalization
@using GovErp.Application.Web.Reference.Contracts
@using GovErp.Application.Web.Validation.Contracts

@* Строки документа. Колонка PO line — только при выбранном заказе (выбор из его строк); Available after и Status —
   из показанной оценки; при несохранённых правках эти колонки пустые: оценка относится к сохранённой версии. *@
<table class="lines">
    <thead>
        <tr>
            <th>#</th><th>Fund</th><th>Dept</th><th>Object</th><th>Grant</th><th>Account</th><th class="money">Amount</th>
            @if (Edit.HasPo) { <th>PO line</th> }
            <th class="money">Available after</th><th>Status</th>
            @if (Editable) { <th></th> }
        </tr>
    </thead>
    <tbody>
    @for (var i = 0; i < Edit.Lines.Count; i++)
    {
        var line = Edit.Lines[i];
        var lineNo = i + 1;
        var (status, tone) = Stale ? ("—", "muted") : LineStatus(lineNo);
        <tr>
            <td>@lineNo</td>
            @if (Editable)
            {
                <td>@Select(line.Fund, v => line.Fund = v, Segments?.Funds, allowEmpty: false)</td>
                <td>@Select(line.Department, v => line.Department = v, Segments?.Departments, allowEmpty: false)</td>
                <td>@Select(line.Object, v => line.Object = v, Segments?.Objects, allowEmpty: false)</td>
                <td>@Select(line.Grant ?? "", v => line.Grant = string.IsNullOrEmpty(v) ? null : v, Segments?.Grants, allowEmpty: true)</td>
                <td>@line.Account</td>
                <td class="money"><input type="number" step="0.01" @bind="line.Amount" @bind:after="ChangedAsync" /></td>
                @if (Edit.HasPo)
                {
                    <td>
                        <select @bind="line.PoLineNo" @bind:after="() => PoLineChangedAsync(line)">
                            <option value="">(none)</option>
                            @foreach (var po in OrderLines)
                            {
                                <option value="@po.LineNo">@po.LineNo · @po.Account · remaining @po.RemainingEncumbrance.ToString("N2", CultureInfo.InvariantCulture)</option>
                            }
                        </select>
                    </td>
                }
            }
            else
            {
                <td><span title="@Name(Segments?.Funds, line.Fund)">@line.Fund</span></td>
                <td><span title="@Name(Segments?.Departments, line.Department)">@line.Department</span></td>
                <td><span title="@Name(Segments?.Objects, line.Object)">@line.Object</span></td>
                <td><span title="@Name(Segments?.Grants, line.Grant)">@(line.Grant ?? "—")</span></td>
                <td>
                    @if (FiscalYear is { } fy)
                    {
                        <AccountLink Account="@line.Account" FiscalYear="fy" />
                    }
                    else
                    {
                        @line.Account
                    }
                </td>
                <td class="money"><Money Value="line.Amount" /></td>
                @if (Edit.HasPo)
                {
                    <td>@(line.PoLineNo is { } no ? $"{Edit.PoRef}/{no}" : "—")</td>
                }
            }
            <td class="money">
                @if (!Stale && AvailableAfter(lineNo) is { } after)
                {
                    <Money Value="after" />
                }
                else
                {
                    <span class="note">—</span>
                }
            </td>
            <td><span class="chip @tone">@status</span></td>
            @if (Editable)
            {
                <td><button type="button" @onclick="() => RemoveAsync(line)">Remove</button></td>
            }
        </tr>
    }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="6">Line total@(Edit.Difference == 0 ? "" : $" · differs from the header amount by {Edit.Difference.ToString("N2", CultureInfo.InvariantCulture)}")</td>
            <td class="money"><Money Value="Edit.LineSum" /></td>
            <td colspan="@(2 + (Edit.HasPo ? 1 : 0) + (Editable ? 1 : 0))"></td>
        </tr>
    </tfoot>
</table>
@if (Editable)
{
    <p class="toolbar"><button type="button" @onclick="AddAsync">Add line</button></p>
}

@code {
    [Parameter, EditorRequired] public EditorModel Edit { get; set; } = null!;
    [Parameter] public bool Editable { get; set; }
    /// <summary>Бюджетный год сохранённого документа: счёт ведёт на строку бюджета этого года.</summary>
    [Parameter] public int? FiscalYear { get; set; }
    [Parameter] public EvaluationVm? Evaluation { get; set; }
    /// <summary>Форма изменена после сохранения: итоги оценки к ней не относятся.</summary>
    [Parameter] public bool Stale { get; set; }
    [Parameter] public SegmentsVm? Segments { get; set; }
    [Parameter] public IReadOnlyList<PurchaseOrderVm> PurchaseOrders { get; set; } = [];
    [Parameter] public EventCallback OnChange { get; set; }

    private IReadOnlyList<PurchaseOrderLineVm> OrderLines =>
        PurchaseOrders.FirstOrDefault(p => p.Number == Edit.PoRef)?.Lines ?? [];

    private decimal? AvailableAfter(int lineNo) => Evaluation?.LineBudgets.FirstOrDefault(b => b.LineNo == lineNo)?.AvailableAfter;

    /// <summary>Худший итог по строке: неснятый Hard Stop, затем Soft Stop, Warning; снятый override'ом стоп — Released.</summary>
    private (string Label, string Tone) LineStatus(int lineNo)
    {
        if (Evaluation is null)
        {
            return ("Not checked", "muted");
        }

        var outcomes = Evaluation.Outcomes.Where(o => o.Line == lineNo).ToList();
        var open = outcomes.Where(o => o.OverriddenBy is null).Select(o => o.Severity).ToList();
        return open.Contains("HardStop") ? ("Hard stop", "bad")
            : open.Contains("SoftStop") ? ("Soft stop", "warn")
            : open.Contains("Warning") ? ("Warning", "warn")
            : outcomes.Any(o => o.OverriddenBy is not null) ? ("Released", "ok")
            : ("Passed", "ok");
    }

    private static string? Name(IReadOnlyList<SegmentValueVm>? values, string? code) =>
        code is null ? null : values?.FirstOrDefault(v => v.Code == code)?.Name;

    private RenderFragment Select(string value, Action<string> set, IReadOnlyList<SegmentValueVm>? values, bool allowEmpty) => __builder =>
    {
        <select value="@value" @onchange="e => SetAsync(set, e.Value?.ToString() ?? string.Empty)">
            @if (allowEmpty) { <option value="">(none)</option> }
            @if (values is not null)
            {
                @foreach (var s in values)
                {
                    <option value="@s.Code" title="@s.Name">@s.Code</option>
                }
            }
        </select>
    };

    private Task SetAsync(Action<string> set, string value)
    {
        set(value);
        return ChangedAsync();
    }

    /// <summary>Строка заказа задаёт и счёт: ликвидация идёт по счёту encumbrance, другой счёт движок отклонит.</summary>
    private Task PoLineChangedAsync(LineModel line)
    {
        if (OrderLines.FirstOrDefault(l => l.LineNo == line.PoLineNo) is { } po)
        {
            line.SetAccount(po.Account);
        }

        return ChangedAsync();
    }

    private Task AddAsync()
    {
        Edit.Lines.Add(LineModel.Default());
        return ChangedAsync();
    }

    private Task RemoveAsync(LineModel line)
    {
        Edit.Lines.Remove(line);
        return ChangedAsync();
    }

    private Task ChangedAsync() => OnChange.InvokeAsync();
}
