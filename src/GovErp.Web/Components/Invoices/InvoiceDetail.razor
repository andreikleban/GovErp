@using GovErp.Application.Web.Approvals
@using GovErp.Application.Web.Approvals.Contracts
@using GovErp.Application.Web.Audit
@using GovErp.Application.Web.Commands
@using GovErp.Application.Web.Explanation
@using GovErp.Application.Web.Invoices.Commands
@using GovErp.Application.Web.Invoices.Contracts
@using GovErp.Application.Web.Common
@using GovErp.Application.Web.Posting
@using GovErp.Application.Web.Reference.Contracts
@using GovErp.Application.Web.Validation.Contracts
@using GovErp.Web.Authentication
@inject IExplanationAppService Explanations
@inject IApprovalAppService Approvals
@inject IPostingAppService Posting
@inject CurrentActor CurrentActor

<div class="page-header">
    <h1>Invoice @_invoice.Reference <StatusBadge Status="@_invoice.Status" /></h1>
    <button type="button" @onclick="OpenAudit">Audit</button>
</div>
@if (Message is not null) { <p class="error">@Message</p> }
@if (_invoice.Status == "Draft" && !CanEdit && _actorLoaded)
{
    <p class="note">Only the author edits and submits this draft. You can run Validate to see the current result.</p>
}
<InvoiceEditor Edit="_edit" Vendors="Vendors" PurchaseOrders="PurchaseOrders" Segments="Segments" ReadOnly="@(!CanEdit)" />
<InvoiceActions InvoiceId="_invoice.Id" Busy="Busy" CanEdit="CanEdit" CanValidate="CanValidate" CanPost="CanPost" CanWithdraw="CanWithdraw" CanReturn="CanReturn"
                OnSave="SaveAsync" OnValidate="ValidateAsync" OnSubmit="SubmitAsync" OnPost="PostAsync" OnWithdraw="WithdrawAsync" OnReturnToDraft="ReturnAsync"
                Pending="_pending" OnApprove="ApproveAsync" OnReject="RejectAsync" OnOverride="OverrideAsync" />
@if (_selected is { } selected && selected != LatestId && _history.Any(e => e.Id == selected))
{
    <p class="note">Showing a past evaluation from the audit trail. <button type="button" @onclick="ShowLatest">Show latest</button></p>
}
<EvaluationPanel Evaluation="Shown" />
<ExplanationPanel EvaluationId="Shown?.Id" />
<ApprovalRoutePanel Evaluation="Shown" DocumentStatus="@_invoice.Status" Approvals="_invoice.Approvals" />
<PostingPanel Lines="PostingLines" IsPosted="@(_invoice.Status == "Posted")" Check="Shown?.PostingCheck" />
<PaymentHandoffPanel Status="@_invoice.Status" VendorStatus="@VendorStatus" PaymentHold="_invoice.PaymentHold" DueDate="_invoice.DueDate"
                     Ready="_invoice.ReadyForPaymentHandoff" CanSetHold="_isPoster" Busy="Busy" OnSetHold="HoldAsync" />
<AuditDialog Open="_auditOpen" Title="@_invoice.Reference" History="_history" Events="_events" SelectedId="Shown?.Id"
             OnSelect="Select" OnClose="CloseAudit" />

@code {
    [Parameter, EditorRequired] public InvoiceVm Invoice { get; set; } = null!;
    [Parameter] public IReadOnlyList<VendorVm> Vendors { get; set; } = [];
    [Parameter] public IReadOnlyList<PurchaseOrderVm> PurchaseOrders { get; set; } = [];
    [Parameter] public SegmentsVm? Segments { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback<UpdateInvoiceCommand> OnSave { get; set; }
    [Parameter] public EventCallback<InvoiceActionCommand> OnValidate { get; set; }
    [Parameter] public EventCallback<InvoiceActionCommand> OnSubmit { get; set; }
    [Parameter] public EventCallback<InvoiceActionCommand> OnPost { get; set; }
    [Parameter] public EventCallback<ReasonedActionCommand> OnWithdraw { get; set; }
    [Parameter] public EventCallback<InvoiceActionCommand> OnReturnToDraft { get; set; }
    [Parameter] public EventCallback<PaymentHoldCommand> OnPaymentHold { get; set; }
    [Parameter] public EventCallback<InvoiceActionCommand> OnApprove { get; set; }
    [Parameter] public EventCallback<ReasonedActionCommand> OnReject { get; set; }
    [Parameter] public EventCallback<OverrideCommand> OnOverride { get; set; }

    private InvoiceVm _invoice = null!;
    private EditorModel _edit = new();
    private Guid _commandId = Guid.NewGuid();
    private bool _reload;
    private Guid? _selected;
    private IReadOnlyList<EvaluationVm> _history = [];
    private IReadOnlyList<AuditEventVm> _events = [];
    private IReadOnlyList<PreviewLineVm> _journal = [];
    private bool _isPoster;
    private bool _isClerk;
    private bool _actorLoaded;
    private Guid _userId;
    private bool _auditOpen;
    private IReadOnlyList<ApprovalQueueItemVm> _pending = [];

    private bool CanPost => _isPoster && _invoice.Status == "Approved" && (_invoice.LastEvaluation?.Capabilities.CanPost ?? false);
    private bool IsAuthor => _userId == _invoice.CreatedBy;
    /// <summary>Сервер разрешает правку и Submit только автору-AP clerk в Draft; UI не предлагает то, что заведомо будет отклонено.</summary>
    private bool CanEdit => _actorLoaded && _isClerk && IsAuthor && _invoice.Status == "Draft";
    private bool CanWithdraw => IsAuthor && _invoice.Status is "Submitted" or "Approved";
    private bool CanReturn => IsAuthor && _invoice.Status == "Rejected";
    /// <summary>Проверка имеет смысл, пока документ в работе; у проведённого и отклонённого история уже в аудите.</summary>
    private bool CanValidate => _invoice.Status is "Draft" or "Submitted" or "Approved";
    private string VendorStatus => Vendors.FirstOrDefault(v => v.Id == _invoice.VendorId)?.Status ?? "";

    /// <summary>Текущая оценка документа: LastEvaluationRef активного инвойса, для Draft — последняя ручная проверка.</summary>
    private Guid? LatestId => _invoice.LastEvaluationRef ?? _history.OrderByDescending(e => e.EvaluatedAt).FirstOrDefault()?.Id;

    private EvaluationVm? Shown =>
        _history.FirstOrDefault(e => e.Id == _selected) ?? _invoice.LastEvaluation;

    private IReadOnlyList<PreviewLineVm> PostingLines =>
        _invoice.Status == "Posted" ? _journal : Shown?.PostingPreview ?? [];

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_invoice, Invoice))
        {
            // Форму пересобираем только когда документ на сервере действительно изменился (другой документ,
            // новая версия содержания или статус). После отказа Save версия прежняя, и введённые правки остаются в форме.
            var documentChanged = _invoice is null || _invoice.Id != Invoice.Id
                || _invoice.ContentVersion != Invoice.ContentVersion || _invoice.Status != Invoice.Status;
            _invoice = Invoice;
            if (documentChanged)
            {
                _edit = EditorModel.From(Invoice);
            }

            _commandId = Guid.NewGuid();
            _selected = Invoice.LastEvaluationRef;
            _auditOpen = false;
            _reload = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_reload)
        {
            return;
        }

        _reload = false;
        var actor = await CurrentActor.GetAsync();
        _userId = actor.UserKey;
        _isPoster = actor.IsInAnyRole(Roles.Posters);
        _isClerk = actor.IsInRole(Roles.ApClerk);
        _actorLoaded = true;
        _history = await Explanations.GetEvaluationHistoryAsync(_invoice.Id, actor);
        _events = await Explanations.GetAuditTrailAsync(_invoice.Id, actor);
        // Решения, которых по этому документу ждут именно от текущего пользователя (та же очередь, что на странице Approvals).
        _pending = (await Approvals.GetQueueAsync(actor)).Where(q => q.InvoiceId == _invoice.Id).ToList();
        _journal = _invoice.Status == "Posted"
            ? await Posting.GetJournalAsync(_invoice.Id, actor)
            : [];
        _selected ??= _history.OrderByDescending(e => e.EvaluatedAt).FirstOrDefault()?.Id;
    }

    private void OpenAudit() => _auditOpen = true;
    private void CloseAudit() => _auditOpen = false;
    private void ShowLatest() => _selected = LatestId;

    /// <summary>Выбор оценки в журнале закрывает окно: панели карточки показывают её вместо последней.</summary>
    private void Select(Guid id)
    {
        _selected = id;
        _auditOpen = false;
    }

    private Task SaveAsync() => OnSave.InvokeAsync(_edit.ToUpdate(new CommandEnvelope(_commandId, _invoice.RowVersion), _invoice.Id));
    private Task ValidateAsync() => OnValidate.InvokeAsync(new InvoiceActionCommand(new CommandEnvelope(_commandId, _invoice.RowVersion), _invoice.Id));
    private Task SubmitAsync() => OnSubmit.InvokeAsync(new InvoiceActionCommand(new CommandEnvelope(_commandId, _invoice.RowVersion), _invoice.Id));
    private Task PostAsync() => OnPost.InvokeAsync(new InvoiceActionCommand(new CommandEnvelope(_commandId, _invoice.RowVersion), _invoice.Id));
    private Task WithdrawAsync(string reason) => OnWithdraw.InvokeAsync(new ReasonedActionCommand(new CommandEnvelope(_commandId, _invoice.RowVersion), _invoice.Id, reason));
    private Task ReturnAsync() => OnReturnToDraft.InvokeAsync(new InvoiceActionCommand(new CommandEnvelope(_commandId, _invoice.RowVersion), _invoice.Id));
    private Task HoldAsync(bool hold) => OnPaymentHold.InvokeAsync(new PaymentHoldCommand(new CommandEnvelope(_commandId, _invoice.RowVersion), _invoice.Id, hold));
    private Task ApproveAsync(ApprovalQueueItemVm item) =>
        OnApprove.InvokeAsync(new InvoiceActionCommand(new CommandEnvelope(_commandId, _invoice.RowVersion), _invoice.Id));
    private Task RejectAsync((ApprovalQueueItemVm Item, string Reason) decision) =>
        OnReject.InvokeAsync(new ReasonedActionCommand(new CommandEnvelope(_commandId, _invoice.RowVersion), _invoice.Id, decision.Reason));
    private Task OverrideAsync((ApprovalQueueItemVm Item, string Reason) decision) =>
        OnOverride.InvokeAsync(new OverrideCommand(new CommandEnvelope(_commandId, _invoice.RowVersion), _invoice.Id,
            decision.Item.EvaluationId, decision.Item.RuleId!, decision.Item.Line, decision.Reason));
}
