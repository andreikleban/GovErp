@using System.Text.RegularExpressions
@using GovErp.Application.Web.Validation.Contracts

<section class="panel">
    <h2>Results</h2>
    @if (Evaluation is null)
    {
        <p class="note">No saved evaluation.</p>
    }
    else
    {
        <p class="note">
            Overall @Evaluation.Overall · document version @Evaluation.ContentVersion · @Evaluation.Trigger
            · @Evaluation.EvaluatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")
        </p>
        <table>
            <thead>
                <tr><th>#</th><th>Step</th><th>Result</th></tr>
            </thead>
            <tbody>
            @foreach (var step in Evaluation.Steps.OrderBy(s => s.Step))
            {
                var outcomes = Evaluation.Outcomes.Where(o => o.Step == step.Step).ToList();
                var result = ResultOf(step, outcomes, Evaluation);
                <tr>
                    <td>@step.Step</td>
                    <td>@Label(step.Name)</td>
                    <td><span class="chip @Chip(result)">@result</span></td>
                </tr>
                @foreach (var outcome in outcomes)
                {
                    <tr>
                        <td></td>
                        <td colspan="2">
                            <div>
                                @outcome.RuleId v@(outcome.RuleVersion)
                                @if (outcome.Line is { } line) { <span> · line @line</span> }
                                · <span class="chip @(outcome.OverriddenBy is null ? Chip(outcome.Severity) : "muted")">@SeverityLabel(outcome)</span>
                            </div>
                            @if (outcome.Inputs.Count > 0)
                            {
                                <div class="note">Inputs: @string.Join("; ", outcome.Inputs.Select(p => $"{p.Key}={p.Value}"))</div>
                            }
                            @if (outcome.Computed.Count > 0)
                            {
                                <div class="note">Computed: @string.Join("; ", outcome.Computed.Select(p => $"{p.Key}={p.Value}"))</div>
                            }
                            <div>@outcome.Message</div>
                            @if (!string.IsNullOrWhiteSpace(outcome.Resolution))
                            {
                                <div class="note">Action: @outcome.Resolution</div>
                            }
                            @if (outcome.OverriddenBy is { } applied)
                            {
                                <div>Override @applied.Role: @applied.Reason</div>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    }
</section>

@code {
    [Parameter] public EvaluationVm? Evaluation { get; set; }

    /// <summary>
    /// Результат шага различает, что именно мешает: Hard Stop блокирует, неснятый Soft Stop требует override,
    /// снятый override'ом Soft Stop шаг больше не блокирует. Шаг маршрута ничего не «проходит» — он строит список согласований.
    /// </summary>
    private static string ResultOf(StepVm step, IReadOnlyList<OutcomeVm> outcomes, EvaluationVm evaluation)
    {
        if (!step.Executed)
        {
            return "Not evaluated";
        }

        if (step.Name == "ApprovalRequirements")
        {
            var pending = evaluation.ApprovalRoute.Count(r => !r.IsSatisfied);
            return pending == 0 ? "Route complete" : $"{pending} approvals pending";
        }

        if (step.Name == "PostingEligibility" && evaluation.PostingCheck is { Passed: false })
        {
            return "Blocked";
        }

        var open = outcomes.Where(o => o.OverriddenBy is null).ToList();
        if (open.Any(o => o.Severity == "HardStop")) return "Blocked";
        if (open.Any(o => o.Severity == "SoftStop")) return "Needs override";
        if (open.Any(o => o.Severity == "Warning")) return "Warning";
        return outcomes.Any(o => o.OverriddenBy is not null) ? "Overridden" : "Passed";
    }

    private static string SeverityLabel(OutcomeVm outcome) =>
        outcome.OverriddenBy is null ? outcome.Severity : $"{outcome.Severity} · overridden";

    private static string Chip(string value) => value switch
    {
        "Passed" or "Allowed" or "Route complete" => "ok",
        "Warning" or "Needs override" or "SoftStop" => "warn",
        "Blocked" or "HardStop" => "bad",
        _ when value.EndsWith("pending", StringComparison.Ordinal) => "warn",
        _ => "muted",
    };

    private static string Label(string name) => Regex.Replace(name, "([a-z])([A-Z])", "$1 $2");
}
