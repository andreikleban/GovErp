@inherits LayoutComponentBase
@using GovErp.Web.Authentication
@using Microsoft.AspNetCore.Components.Authorization

<div class="app">
    <header class="masthead">
        <div class="brand">
            <span class="mark" aria-hidden="true">GE</span>
            <span>
                <strong>GovErp</strong>
                <small>Municipal financials</small>
            </span>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="session">
                    <span>
                        <strong>@context.User.FindFirst(ActorClaims.Name)?.Value</strong>
                        <small>
                            @string.Join(", ", context.User.FindAll(ActorClaims.Role).Select(c => c.Value))
                            · @context.User.FindFirst(ActorClaims.Tenant)?.Value
                        </small>
                    </span>
                    <form method="post" action="/auth/logout">
                        <AntiforgeryToken />
                        <button type="submit">Sign out</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>
    <div class="workspace">
        <AuthorizeView>
            <Authorized>
                <NavMenu />
            </Authorized>
        </AuthorizeView>
        <main>@Body</main>
    </div>
</div>
