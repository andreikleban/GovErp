@page "/invoices"
@page "/invoices/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@using GovErp.Application.Web.Commands
@using GovErp.Application.Web.Invoices
@using GovErp.Application.Web.Invoices.Commands
@using GovErp.Application.Web.Invoices.Contracts
@using GovErp.Application.Web.Posting
@using GovErp.Application.Web.Reference
@using GovErp.Application.Web.Reference.Contracts
@using GovErp.Web.Authentication
@using GovErp.Web.Formatting
@using GovErp.Web.Components.Invoices
@using Microsoft.AspNetCore.Authorization
@inject IInvoiceAppService InvoiceService
@inject IPostingAppService Posting
@inject GovErp.Application.Web.Approvals.IApprovalAppService Approvals
@inject IReferenceAppService Reference
@inject CurrentActor CurrentActor
@inject NavigationManager Navigation

<PageTitle>Invoices</PageTitle>
@if (Id is null)
{
    <h1>Invoices</h1>
    @if (_canCreate)
    {
        <p class="toolbar">
            <a class="button primary" href="/invoices/new">New</a>
            <button type="button" disabled="@_busy" @onclick="() => PresetAsync(InvoicePreset.NonPoGrant)">Non-PO</button>
            <button type="button" disabled="@_busy" @onclick="() => PresetAsync(InvoicePreset.PoBackedGrant)">PO-backed</button>
            <button type="button" disabled="@_busy" @onclick="() => PresetAsync(InvoicePreset.MultiFund)">Multi-fund</button>
        </p>
    }
    @if (_error is not null) { <p class="error">@_error</p> }
    @if (_list is { Count: 0 })
    {
        <p class="note">
            @(_canCreate
                ? "No invoices yet. New opens an empty form; Non-PO, PO-backed and Multi-fund create the demo invoices from the exercise."
                : "No invoices yet. AP clerks create them; approvals waiting for you appear under Approvals.")
        </p>
    }
    <table>
        <thead><tr><th>Document</th><th>Vendor invoice</th><th>Vendor</th><th class="money">Amount</th><th>Status</th><th>Last evaluation</th></tr></thead>
        <tbody>
        @if (_list is not null)
        {
            @foreach (var row in _list)
            {
                <tr>
                    <td><a href="@($"/invoices/{row.Id}")">@row.Reference</a></td>
                    <td>@row.Number</td>
                    <td>@row.VendorName</td>
                    <td class="money">@MoneyText.Usd(row.Total)</td>
                    <td><StatusBadge Status="@row.Status" /></td>
                    <td>@row.LastOverall</td>
                </tr>
            }
        }
        </tbody>
    </table>
}
else if (_invoice is not null)
{
    <InvoiceDetail Invoice="_invoice" Vendors="_vendors" PurchaseOrders="_orders" Segments="_segments"
                   Busy="_busy" Message="@_error" OnSave="SaveAsync" OnValidate="ValidateAsync" OnSubmit="SubmitAsync" OnPost="PostAsync"
                   OnWithdraw="WithdrawAsync" OnReturnToDraft="ReturnAsync" OnPaymentHold="HoldAsync"
                   OnApprove="ApproveAsync" OnReject="RejectAsync" OnOverride="OverrideAsync" />
}

@code {
    [Parameter] public Guid? Id { get; set; }
    private IReadOnlyList<InvoiceListItemVm>? _list;
    private InvoiceVm? _invoice;
    private IReadOnlyList<VendorVm> _vendors = [];
    private IReadOnlyList<PurchaseOrderVm> _orders = [];
    private SegmentsVm? _segments;
    private bool _busy;
    private bool _canCreate;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        var actor = await CurrentActor.GetAsync();
        _canCreate = actor.IsInRole(GovErp.Application.Web.Common.Roles.ApClerk);
        _vendors = await Reference.GetVendorsAsync(actor);
        _orders = await Reference.GetPurchaseOrdersAsync(actor);
        _segments = await Reference.GetSegmentsAsync(actor);
        if (Id is { } id)
        {
            _invoice = await InvoiceService.GetAsync(id, actor);
        }
        else
        {
            _list = await InvoiceService.ListAsync(InvoiceListFilter.None, actor);
        }
    }

    private async Task PresetAsync(InvoicePreset preset)
    {
        var actor = await CurrentActor.GetAsync();
        await RunAsync(async () =>
        {
            var r = await InvoiceService.CreateFromPresetAsync(preset, new CommandEnvelope(Guid.NewGuid(), null), actor);
            if (!r.IsAccepted) { _error = r.Reason; return; }
            Navigation.NavigateTo($"/invoices/{r.Value!.Id}", forceLoad: true);
        });
    }

    private Task SaveAsync(UpdateInvoiceCommand cmd) => ApplyAsync(a => InvoiceService.UpdateDraftAsync(cmd, a));
    private Task ValidateAsync(InvoiceActionCommand cmd) => ApplyAsync(a => InvoiceService.ValidateAsync(cmd, a));
    private Task SubmitAsync(InvoiceActionCommand cmd) => ApplyAsync(a => InvoiceService.SubmitAsync(cmd, a));
    private Task PostAsync(InvoiceActionCommand cmd) => ApplyAsync(a => Posting.PostAsync(cmd, a));
    private Task WithdrawAsync(ReasonedActionCommand cmd) => ApplyAsync(a => InvoiceService.WithdrawAsync(cmd, a));
    private Task ReturnAsync(InvoiceActionCommand cmd) => ApplyAsync(a => InvoiceService.ReturnToDraftAsync(cmd, a));
    private Task HoldAsync(PaymentHoldCommand cmd) => ApplyAsync(a => InvoiceService.SetPaymentHoldAsync(cmd, a));
    private Task ApproveAsync(InvoiceActionCommand cmd) => ApplyAsync(a => Approvals.ApproveAsync(cmd, a));
    private Task RejectAsync(ReasonedActionCommand cmd) => ApplyAsync(a => Approvals.RejectAsync(cmd, a));
    private Task OverrideAsync(OverrideCommand cmd) => ApplyAsync(a => Approvals.OverrideAsync(cmd, a));

    private async Task ApplyAsync(Func<GovErp.Application.Web.Common.ActorContext, Task<CommandResult<InvoiceVm>>> action)
    {
        var actor = await CurrentActor.GetAsync();
        await RunAsync(async () =>
        {
            var r = await action(actor);
            if (r.Status == CommandStatus.Conflict && r.Retryable) { _error = "Data changed — reload the document."; }
            else if (r.Status == CommandStatus.Forbidden) { _error = $"Not allowed: {r.Reason}"; }
            else if (!r.IsAccepted) { _error = r.Reason; }
            else { _error = null; }
            if (Id is { } id) { _invoice = await InvoiceService.GetAsync(id, actor); }
        });
    }

    private async Task RunAsync(Func<Task> body)
    {
        _busy = true;
        try { await body(); }
        finally { _busy = false; }
    }
}
