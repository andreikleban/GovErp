@page "/invoices/new"
@page "/invoices/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@using GovErp.Application.Web.Approvals
@using GovErp.Application.Web.Commands
@using GovErp.Application.Web.Common
@using GovErp.Application.Web.Invoices
@using GovErp.Application.Web.Invoices.Commands
@using GovErp.Application.Web.Invoices.Contracts
@using GovErp.Application.Web.Posting
@using GovErp.Application.Web.Reference
@using GovErp.Application.Web.Reference.Contracts
@using GovErp.Web.Authentication
@using GovErp.Web.Components.Invoices
@inject IInvoiceAppService InvoiceService
@inject IPostingAppService Posting
@inject IApprovalAppService Approvals
@inject IReferenceAppService Reference
@inject CurrentActor CurrentActor
@inject IClock Clock
@inject NavigationManager Navigation

<PageTitle>@(_invoice?.Reference ?? "New invoice")</PageTitle>
@if (Id is null && _loaded && !_canCreate)
{
    <Breadcrumbs Items="@([new Crumb("Payables"), new Crumb("Invoices", "/invoices"), new Crumb("New")])" />
    <h1>New invoice</h1>
    <p class="error">Only AP clerks create invoices.</p>
}
else if (Id is null ? _draft is not null : _invoice is not null)
{
    <InvoiceCard Invoice="_invoice" Draft="_draft" Vendors="_vendors" PurchaseOrders="_orders" Segments="_segments"
                 Busy="_busy" Message="@_error" InitialEvaluationId="Evaluation"
                 OnCreate="CreateAsync" OnSave="SaveAsync" OnValidate="ValidateAsync" OnSubmit="SubmitAsync" OnPost="PostAsync"
                 OnWithdraw="WithdrawAsync" OnReturnToDraft="ReturnAsync" OnPaymentHold="HoldAsync"
                 OnApprove="ApproveAsync" OnReject="RejectAsync" OnOverride="OverrideAsync" />
}
else
{
    <p class="note">Loading the invoice.</p>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    /// <summary>Opens the card on a past evaluation (a link from the audit).</summary>
    [SupplyParameterFromQuery(Name = "evaluation")] public Guid? Evaluation { get; set; }

    private InvoiceVm? _invoice;
    private EditorModel? _draft;
    private IReadOnlyList<VendorVm> _vendors = [];
    private IReadOnlyList<PurchaseOrderVm> _orders = [];
    private SegmentsVm? _segments;
    private bool _loaded;
    private bool _canCreate;
    private bool _busy;
    private string? _error;
    private string? _suggested;
    private Guid _createCommandId = Guid.NewGuid();

    protected override async Task OnParametersSetAsync()
    {
        var actor = await CurrentActor.GetAsync();
        _canCreate = actor.IsInRole(Roles.ApClerk);
        _error = null;
        _vendors = await Reference.GetVendorsAsync(actor);
        _orders = await Reference.GetPurchaseOrdersAsync(actor);
        _segments = await Reference.GetSegmentsAsync(actor);
        if (Id is { } id)
        {
            _draft = null;
            _invoice = await InvoiceService.GetAsync(id, actor);
        }
        else
        {
            _invoice = null;
            if (_canCreate)
            {
                var vendor = _vendors.FirstOrDefault(v => v.Status == "Active") ?? _vendors.FirstOrDefault();
                _draft = EditorModel.Blank(vendor?.Id ?? Guid.Empty, Clock.BusinessDate);
                _suggested = await InvoiceService.SuggestNumberAsync(Clock.BusinessDate, actor);
                _draft.Number = _suggested;
                _createCommandId = Guid.NewGuid();
            }
        }

        _loaded = true;
    }

    private async Task CreateAsync(EditorModel edit)
    {
        // The button is not disabled for an empty number: the field updates the model only when focus leaves,
        // and an inactive button without an explanation looks broken. Say what is missing.
        if (string.IsNullOrWhiteSpace(edit.Number))
        {
            _error = "Enter the vendor's invoice number (as printed on the invoice).";
            return;
        }

        await RunAsync(async () =>
        {
            var actor = await CurrentActor.GetAsync();
            var command = edit.ToCreate(new CommandEnvelope(_createCommandId, null));
            if (edit.Number.Trim() == _suggested)
            {
                // The suggested number was not reserved: the server issues it from the sequence on save,
                // so it matches the registration number even if someone created a document earlier.
                command = command with { Number = "", GeneratedNumberPrefix = IInvoiceNumbering.SuggestedPrefix };
            }

            var result = await InvoiceService.CreateDraftAsync(command, actor);
            if (result.IsAccepted)
            {
                Navigation.NavigateTo($"/invoices/{result.Value!.Id}");
                return;
            }

            // The refusal saved nothing; the next attempt with corrected data is a new command.
            _error = result.Reason;
            _createCommandId = Guid.NewGuid();
        });
    }

    private Task SaveAsync(UpdateInvoiceCommand cmd) => ApplyAsync(a => InvoiceService.UpdateDraftAsync(cmd, a));
    private Task ValidateAsync(InvoiceActionCommand cmd) => ApplyAsync(a => InvoiceService.ValidateAsync(cmd, a));
    private Task SubmitAsync(InvoiceActionCommand cmd) => ApplyAsync(a => InvoiceService.SubmitAsync(cmd, a));
    private Task PostAsync(InvoiceActionCommand cmd) => ApplyAsync(a => Posting.PostAsync(cmd, a));
    private Task WithdrawAsync(ReasonedActionCommand cmd) => ApplyAsync(a => InvoiceService.WithdrawAsync(cmd, a));
    private Task ReturnAsync(InvoiceActionCommand cmd) => ApplyAsync(a => InvoiceService.ReturnToDraftAsync(cmd, a));
    private Task HoldAsync(PaymentHoldCommand cmd) => ApplyAsync(a => InvoiceService.SetPaymentHoldAsync(cmd, a));
    private Task ApproveAsync(InvoiceActionCommand cmd) => ApplyAsync(a => Approvals.ApproveAsync(cmd, a));
    private Task RejectAsync(ReasonedActionCommand cmd) => ApplyAsync(a => Approvals.RejectAsync(cmd, a));
    private Task OverrideAsync(OverrideCommand cmd) => ApplyAsync(a => Approvals.OverrideAsync(cmd, a));

    private async Task ApplyAsync(Func<ActorContext, Task<CommandResult<InvoiceVm>>> action)
    {
        var actor = await CurrentActor.GetAsync();
        await RunAsync(async () =>
        {
            var r = await action(actor);
            _error = r.Status == CommandStatus.Conflict && r.Retryable ? "Data changed — reload the document."
                : r.Status == CommandStatus.Forbidden ? $"Not allowed: {r.Reason}"
                : !r.IsAccepted ? r.Reason
                : null;
            if (Id is { } id)
            {
                _invoice = await InvoiceService.GetAsync(id, actor);
            }
        });
    }

    private async Task RunAsync(Func<Task> body)
    {
        _busy = true;
        try { await body(); }
        finally { _busy = false; }
    }
}
