@page "/invoices/new"
@attribute [Authorize]
@rendermode InteractiveServer
@using GovErp.Application.Web.Commands
@using GovErp.Application.Web.Common
@using GovErp.Application.Web.Invoices
@using GovErp.Application.Web.Reference
@using GovErp.Application.Web.Reference.Contracts
@using GovErp.Web.Authentication
@using GovErp.Web.Components.Invoices
@inject IInvoiceAppService InvoiceService
@inject IReferenceAppService Reference
@inject CurrentActor CurrentActor
@inject IClock Clock
@inject NavigationManager Navigation

<PageTitle>New invoice</PageTitle>
<h1>New invoice</h1>
@if (_loaded && !_canCreate)
{
    <p class="error">Only AP clerks create invoices.</p>
}
else if (_edit is not null)
{
    <p class="note">Nothing is stored until you press Save. The document number (AP-year-sequence) is assigned on save.
        The vendor invoice number is suggested from the same sequence; keep it or enter the number printed on the vendor's invoice.</p>
    @if (_error is not null) { <p class="error">@_error</p> }
    <InvoiceEditor Edit="_edit" Vendors="_vendors" PurchaseOrders="_orders" Segments="_segments" NumberEditable="true" />
    <p class="toolbar">
        <button class="primary" type="button" disabled="@_busy" @onclick="SaveAsync">Save</button>
        <a href="/invoices">Cancel</a>
    </p>
}

@code {
    private EditorModel? _edit;
    private IReadOnlyList<VendorVm> _vendors = [];
    private IReadOnlyList<PurchaseOrderVm> _orders = [];
    private SegmentsVm? _segments;
    private bool _loaded;
    private bool _canCreate;
    private bool _busy;
    private string? _error;
    private Guid _commandId = Guid.NewGuid();
    private string? _suggested;

    protected override async Task OnInitializedAsync()
    {
        var actor = await CurrentActor.GetAsync();
        _canCreate = actor.IsInRole(Roles.ApClerk);
        _loaded = true;
        if (!_canCreate)
        {
            return;
        }

        _vendors = await Reference.GetVendorsAsync(actor);
        _orders = await Reference.GetPurchaseOrdersAsync(actor);
        _segments = await Reference.GetSegmentsAsync(actor);
        var vendor = _vendors.FirstOrDefault(v => v.Status == "Active") ?? _vendors.FirstOrDefault();
        _edit = EditorModel.Blank(vendor?.Id ?? Guid.Empty, Clock.BusinessDate);
        _suggested = await InvoiceService.SuggestNumberAsync(Clock.BusinessDate, actor);
        _edit.Number = _suggested;
    }

    private async Task SaveAsync()
    {
        // Кнопка не выключается по пустому номеру: поле обновляет модель только при уходе фокуса,
        // и неактивная кнопка без объяснения выглядит как поломка. Говорим, чего не хватает.
        if (string.IsNullOrWhiteSpace(_edit!.Number))
        {
            _error = "Enter the vendor's invoice number (as printed on the invoice).";
            return;
        }

        _busy = true;
        try
        {
            var actor = await CurrentActor.GetAsync();
            var command = _edit.ToCreate(new CommandEnvelope(_commandId, null));
            if (_edit.Number.Trim() == _suggested)
            {
                // Предложенный номер не резервировался: сервер выдаст его из последовательности при сохранении,
                // так что он совпадёт с регистрационным номером, даже если кто-то создал документ раньше.
                command = command with { Number = "", GeneratedNumberPrefix = IInvoiceNumbering.SuggestedPrefix };
            }

            var result = await InvoiceService.CreateDraftAsync(command, actor);
            if (result.IsAccepted)
            {
                Navigation.NavigateTo($"/invoices/{result.Value!.Id}", forceLoad: true);
                return;
            }

            // Отказ не сохранил ничего; следующая попытка с исправленными данными — новая команда.
            _error = result.Reason;
            _commandId = Guid.NewGuid();
        }
        finally
        {
            _busy = false;
        }
    }
}
