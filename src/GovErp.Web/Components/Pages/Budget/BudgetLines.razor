@page "/budget"
@attribute [Authorize]
@rendermode InteractiveServer
@using GovErp.Application.Web.Budget
@using GovErp.Application.Web.Budget.Contracts
@using GovErp.Web.Authentication
@inject IBudgetAppService Budgets
@inject CurrentActor CurrentActor

<PageTitle>Budget Lines</PageTitle>
<Breadcrumbs Items="@([new Crumb("Budget"), new Crumb("Budget Lines")])" />
<h1>Budget Lines</h1>
<p class="note">
    Open a line for its amendments, held reservations and encumbrances. <a href="/budget/amendments">Amendments</a> and
    <a href="/budget/encumbrances">Encumbrances</a> also list them across every line.
</p>
@if (_error is not null) { <p class="error">@_error</p> }
<label>Fiscal year <input type="number" @bind="_year" /></label>
<p class="toolbar"><button type="button" disabled="@_busy" @onclick="LoadAsync">Show</button></p>
@if (_lines is not null)
{
    <table>
        <thead>
            <tr>
                <th>FY</th><th>Account</th>
                <th class="money">Opening actuals</th><th class="money">Opening encumbered</th>
                <th class="money">Adopted</th><th class="money">Amended</th><th class="money">Actuals</th><th class="money">Encumbered</th>
                <th class="money">Held</th><th class="money">Available</th>
            </tr>
        </thead>
        <tbody>
        @if (_lines.Count == 0)
        {
            <tr><td colspan="10" class="note">No budget lines for this fiscal year.</td></tr>
        }
        @foreach (var line in _lines)
        {
            <tr>
                <td>@line.FiscalYear</td>
                <td><a href="@Href(line)">@line.Account</a></td>
                <td class="money"><Money Value="line.OpeningActuals" /></td>
                <td class="money"><Money Value="line.OpeningEncumbered" /></td>
                <td class="money"><Money Value="line.Adopted" /></td>
                <td class="money"><Money Value="line.Amended" /></td>
                <td class="money"><Money Value="line.Actuals" /></td>
                <td class="money"><Money Value="line.Encumbered" /></td>
                <td class="money"><Money Value="line.Held" /></td>
                <td class="money"><Money Value="line.Available" /></td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private int _year = 2026;
    private IReadOnlyList<BudgetLineVm>? _lines;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private static string Href(BudgetLineVm line) => $"/budget/lines/{Uri.EscapeDataString(line.Account)}/{line.FiscalYear}";

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            var actor = await CurrentActor.GetAsync();
            _lines = await Budgets.ListAsync(_year, actor);
            _error = null;
        }
        catch (ArgumentException ex)
        {
            // An invalid budget year from the input field is a message, not a broken circuit.
            _error = ex.Message;
            _lines = [];
        }
        finally
        {
            _busy = false;
        }
    }
}
